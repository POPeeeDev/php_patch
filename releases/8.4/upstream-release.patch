diff --git a/ext/standard/tests/image/iptcembed_reentrant.phpt b/ext/standard/tests/image/iptcembed_reentrant.phpt
new file mode 100644
index 00000000000..758e50378b0
--- /dev/null
+++ b/ext/standard/tests/image/iptcembed_reentrant.phpt
@@ -0,0 +1,34 @@
+--TEST--
+iptcembed() keeps APP13 headers local during reentrant output handling
+--FILE--
+<?php
+$file = __DIR__ . '/iptcembed_reentrant.jpg';
+file_put_contents($file, "\xff\xd8\xff\xe0\x00\x02\xff\xda\x00\x02");
+$output = '';
+$nested = false;
+ob_start(function ($chunk) use (&$output, &$nested, $file) {
+    $output .= $chunk;
+    if (!$nested && str_ends_with($output, "\xff\xed")) {
+        $nested = true;
+        iptcembed(str_repeat('B', 256), $file, 0);
+    }
+    return '';
+}, 1);
+iptcembed('AA', $file, 2);
+ob_end_flush();
+$start = strpos($output, "\xff\xed");
+echo "Nested call: ";
+var_dump($nested);
+echo "APP13 length: ";
+var_dump(unpack('n', substr($output, $start + 2, 2))[1]);
+echo "Outer payload: ";
+var_dump(substr($output, $start + 30, 2));
+?>
+--CLEAN--
+<?php
+unlink(__DIR__ . '/iptcembed_reentrant.jpg');
+?>
+--EXPECT--
+Nested call: bool(true)
+APP13 length: int(30)
+Outer payload: string(2) "AA"
diff --git a/ext/standard/tests/image/oom_getimagesize_cws.inc b/ext/standard/tests/image/oom_getimagesize_cws.inc
new file mode 100644
index 00000000000..157b9f8fe52
--- /dev/null
+++ b/ext/standard/tests/image/oom_getimagesize_cws.inc
@@ -0,0 +1,17 @@
+<?php
+
+function generate_file(string $path) {
+    $file = fopen($path, 'wb');
+    $uncompressedSize = 320 * 1024 * 1024;
+    fwrite($file, "CWS\x06" . pack('V', $uncompressedSize + 8));
+    $deflate = deflate_init(ZLIB_ENCODING_DEFLATE, ['level' => 9]);
+    $chunk = str_repeat('A', 1024 * 1024);
+    for ($i = 0; $i < 320; $i++) {
+        fwrite($file, deflate_add(
+            $deflate,
+            $chunk,
+            $i === 319 ? ZLIB_FINISH : ZLIB_NO_FLUSH,
+        ));
+    }
+    fclose($file);
+}
