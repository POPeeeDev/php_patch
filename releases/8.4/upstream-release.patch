+<?php
+$mbi = function (int $v): string {          // WBMP multi-byte integer
+    $out = chr($v & 0x7f);
+    for ($v >>= 7; $v > 0; $v >>= 7) {
+        $out = chr(0x80 | ($v & 0x7f)) . $out;
+    }
+    return $out;
+};
