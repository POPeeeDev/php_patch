diff --git a/ext/exif/tests/oom_exif_big_thumbnail.inc b/ext/exif/tests/oom_exif_big_thumbnail.inc
new file mode 100644
index 00000000000..62e7aaa0af5
--- /dev/null
+++ b/ext/exif/tests/oom_exif_big_thumbnail.inc
@@ -0,0 +1,47 @@
+<?php
+
+/* Writes a TIFF whose thumbnail IFD points at $size bytes that really are in the
+ * file. */
+function oom_exif_write_big_thumbnail(string $path, int $size): void
+{
+    $ifd1_off    = 8 + 2 + 2*12 + 4;
+    $payload_off = $ifd1_off + 2 + 2*12 + 4;
+
+    $t  = "II*\x00" . pack('V', 8);
+    $t .= pack('v', 2);
+    $t .= pack('vvVV', 0x0100, 4, 1, 1);                // ImageWidth
+    $t .= pack('vvVV', 0x0101, 4, 1, 1);                // ImageLength
+    $t .= pack('V', $ifd1_off);                         // next IFD = thumbnail IFD
+    $t .= pack('v', 2);
+    $t .= pack('vvVV', 0x0111, 4, 1, $payload_off);     // StripOffsets -> real data
+    $t .= pack('vvVV', 0x0117, 4, 1, $size);            // StripByteCounts
+    $t .= pack('V', 0);
+
+    $fp = fopen($path, 'wb');
+    fwrite($fp, $t);
+    $chunk = str_repeat("\xAB", 1024 * 1024);
+    for ($written = 0; $written < $size; $written += strlen($chunk)) {
+        fwrite($fp, $chunk);
+    }
+    fclose($fp);
+}
+
+/* Writes a TIFF with a single tag of $count elements of $format, whose value
+ * really is present in the file. $bytes_per is the format's element size. */
+function oom_exif_write_big_tag(string $path, int $tag, int $format, int $count, int $bytes_per = 1): void
+{
+    $payload_off = 8 + 2 + 12 + 4;
+    $t  = "II*\x00" . pack('V', 8);
+    $t .= pack('v', 1);
+    $t .= pack('vvVV', $tag, $format, $count, $payload_off);
+    $t .= pack('V', 0);
+
+    $fp = fopen($path, 'wb');
+    fwrite($fp, $t);
+    $size = $count * $bytes_per;
+    $chunk = str_repeat("\x01", 1024 * 1024);
+    for ($written = 0; $written < $size; $written += strlen($chunk)) {
+        fwrite($fp, substr($chunk, 0, min(strlen($chunk), $size - $written)));
+    }
+    fclose($fp);
+}
diff --git a/ext/exif/tests/oom_exif_numeric_metadata.phpt b/ext/exif/tests/oom_exif_numeric_metadata.phpt
new file mode 100644
index 00000000000..93b9027923b
--- /dev/null
+++ b/ext/exif/tests/oom_exif_numeric_metadata.phpt
@@ -0,0 +1,38 @@
+--TEST--
+exif_read_data() with expanded numeric metadata doesn't reach hard limit
+--EXTENSIONS--
+exif
+--INI--
+memory_limit=128M
+--FILE--
+<?php
+$base = file_get_contents(__DIR__ . '/image011.jpg');
+$entryCount = 900;
+$componentCount = 12000;
+$dataOffset = 8 + 2 + $entryCount * 12 + 4;
+
+$entries = '';
+for ($i = 0; $i < $entryCount; $i++) {
+    // Each unique tag retains its own numeric list, while all tags share the
+    // same in-bounds payload in the JPEG's TIFF data.
+    $entries .= pack('vvVV', 0xf000 + $i, 3, $componentCount, $dataOffset);
+}
+
+$tiff = "II*\0" . pack('V', 8)
+    . pack('v', $entryCount) . $entries . pack('V', 0)
+    . str_repeat("\0", $componentCount * 2);
+$app1 = "Exif\0\0" . $tiff;
+$jpeg = "\xff\xd8\xff\xe1" . pack('n', strlen($app1) + 2) . $app1 . substr($base, 2);
+
+$file = __DIR__ . '/oom_exif_numeric_metadata.jpg';
+file_put_contents($file, $jpeg);
+unset($base, $entries, $tiff, $app1, $jpeg);
+
+exif_read_data($file);
+?>
+--CLEAN--
+<?php
+@unlink(__DIR__ . '/oom_exif_numeric_metadata.jpg');
+?>
+--EXPECTF--
+Fatal error: Allowed memory size of 134217728 bytes exhausted %S(tried to allocate %d bytes) in %s on line %d
